# Публичный адрес сайта — используется в metadata, sitemap и JSON-LD
NEXT_PUBLIC_SITE_URL=https://fortinox.ru

# --- Секреты только на сервере / в панели Amvera. В git и NEXT_PUBLIC_* не класть. ---

# Заявки в Telegram (BotFather → токен; chat_id через запятую при нескольких)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Заявки в MAX (токен бота из @MasterBot; числовые user_id через запятую —
# это не slug из ссылки max.ru/u/…, а ID пользователя для Bot API)
MAX_BOT_TOKEN=
MAX_RECIPIENT_IDS=

# Вебхук CRM (amoCRM / Битрикс24 / собственный приёмник)
CRM_WEBHOOK_URL=

# Яндекс.Метрика. Пока переменная пуста, счётчик не подключается вовсе
# и в браузер посетителя не уходит ни одного запроса к Яндексу.
NEXT_PUBLIC_YM_ID=

# HSTS. Включать (=1) только после того, как HTTPS настроен и проверен:
# заголовок заставляет браузеры ходить только по https целый год.
ENABLE_HSTS=0
